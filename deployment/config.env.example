# Lambda Configuration Example
# Copy this file to config.env and update with your values

# AWS Configuration
AWS_REGION=us-east-1

# Lambda Function Name
LAMBDA_PROCESS_CLIP=opus-process-clip

# S3 Bucket Name
BUCKET_NAME=opus-clip-videos

# Lambda IAM Role ARN (required for creating new functions)
# Get your role ARN from AWS Console > IAM > Roles
# The role needs these permissions:
#   - AWSLambdaBasicExecutionRole (for CloudWatch Logs)
#   - AmazonS3FullAccess (for S3 access)
# LAMBDA_ROLE_ARN=arn:aws:iam::123456789012:role/opus-clip-lambda-role

# Optional: Custom endpoints (for Cloudflare R2, etc.)
# R2_ENDPOINT=https://your-account.r2.cloudflarestorage.com
# R2_ACCESS_KEY=your_r2_access_key
# R2_SECRET_KEY=your_r2_secret_key
