# Dockerfile for opus-download Lambda Function (ECR Deployment)
# This creates a container image for the download Lambda function
# Uses AWS Lambda Python 3.11 base image for compatibility

FROM public.ecr.aws/lambda/python:3.11

# Set working directory
WORKDIR ${LAMBDA_TASK_ROOT}

# Install system dependencies for yt-dlp
# ffmpeg is required by yt-dlp for video processing and format conversion
RUN yum update -y && \
    yum install -y ffmpeg && \
    yum clean all && \
    rm -rf /var/cache/yum

# Copy requirements file
COPY requirements-download.txt .

# Install Python dependencies
# Using --no-cache-dir to reduce image size
# Using --upgrade pip to ensure latest version
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements-download.txt

# Copy the Lambda function code
COPY 1-lambda-download.py lambda_function.py

# Set environment variables
ENV PYTHONUNBUFFERED=1

# Lambda handler
CMD ["lambda_function.lambda_handler"]
