# OpusClip Cloud - Environment Variables
# Copy this file to .env and fill in your values

# ========================================
# AWS Configuration
# ========================================
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012

# ========================================
# Storage Configuration
# ========================================
# S3/R2/B2 Bucket
BUCKET_NAME=opus-clip-videos

# S3 Prefix Sharding (for high throughput)
USE_S3_SHARDING=true

# Optional: Cloudflare R2 or Backblaze B2
R2_ENDPOINT=https://[account-id].r2.cloudflarestorage.com
R2_ACCESS_KEY=your-r2-access-key
R2_SECRET_KEY=your-r2-secret-key
R2_PUBLIC_DOMAIN=pub-xxxxx.r2.dev

# ========================================
# Database Configuration
# ========================================
# DynamoDB Tables
DYNAMODB_VIDEO_SESSIONS_TABLE=prod-video-sessions
DYNAMODB_WEBSOCKET_CONNECTIONS_TABLE=prod-websocket-connections

# ========================================
# Cache Configuration
# ========================================
# ElastiCache Redis (requires VPC)
REDIS_ENDPOINT=your-redis-cluster.cache.amazonaws.com
REDIS_PORT=6379
REDIS_PASSWORD=  # Leave empty if no password

# ========================================
# Queue Configuration
# ========================================
# SQS Queue URLs
VIDEO_PROCESSING_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456/prod-video-processing-queue
UPLOAD_PROCESSING_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456/prod-upload-processing-queue

# ========================================
# Step Functions
# ========================================
STATE_MACHINE_ARN=arn:aws:states:us-east-1:123456:stateMachine:youtube-workflow
STATE_MACHINE_ARN_UPLOAD=arn:aws:states:us-east-1:123456:stateMachine:upload-workflow

# ========================================
# API Gateway
# ========================================
ALLOWED_ORIGINS=https://app.example.com,https://example.com

# ========================================
# Firebase Configuration
# ========================================
FIREBASE_PROJECT_ID=reframeai-87b24
FIREBASE_WEB_API_KEY=AIzaSy...

# ========================================
# Transcription APIs
# ========================================
# Groq API (Primary - Fast, free tier)
GROQ_API_KEY=gsk_xxxxx

# AssemblyAI (Fallback 1)
ASSEMBLYAI_API_KEY=xxxxx

# Deepgram (Fallback 2)
DEEPGRAM_API_KEY=xxxxx

# Local Whisper Settings
USE_LOCAL_WHISPER=false
WHISPER_MODEL=base  # Options: tiny, base, small, medium, large

# ========================================
# Video Processing Settings
# ========================================
# Clip Detection
NUM_CLIPS=3
MIN_CLIP_DURATION=15
MAX_CLIP_DURATION=60
TARGET_CLIP_DURATION=45
USE_AI_SCORING=true

# Aspect Ratios
ASPECT_RATIO=9:16  # Options: 9:16, 16:9, 1:1

# Subtitles
ADD_SUBTITLES=true

# Smart Framing
ENABLE_SMART_FRAMING=false

# FFmpeg Paths (from Lambda layer)
FFMPEG_PATH=/opt/bin/ffmpeg
FFPROBE_PATH=/opt/bin/ffprobe

# ========================================
# Download Settings
# ========================================
QUALITY_MODE=balanced  # Options: fast, balanced, best
SKIP_INFO_FETCH=false

# YouTube Cookies (optional, for age-restricted videos)
COOKIES_S3_KEY=config/youtube-cookies.txt

# ========================================
# Upload Settings
# ========================================
MAX_FILE_SIZE=524288000  # 500 MB
UPLOAD_EXPIRY=3600  # 1 hour

# ========================================
# Monitoring & Logging
# ========================================
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR
ENABLE_STRUCTURED_LOGGING=true
CLOUDWATCH_NAMESPACE=VideoProcessing

# ========================================
# WebSocket Configuration
# ========================================
WEBSOCKET_API_ENDPOINT=wss://your-websocket-id.execute-api.us-east-1.amazonaws.com/prod

# ========================================
# Security & Rate Limiting
# ========================================
# Rate limiting enabled by default when Redis is available
ENABLE_RATE_LIMITING=true

# Circuit breaker settings
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=60

# ========================================
# Performance Settings
# ========================================
# Lambda Memory (MB)
LAMBDA_MEMORY_API_GATEWAY=512
LAMBDA_MEMORY_DOWNLOAD=2048
LAMBDA_MEMORY_TRANSCRIBE=3072
LAMBDA_MEMORY_DETECT_CLIPS=2048
LAMBDA_MEMORY_PROCESS_CLIP=3072
LAMBDA_MEMORY_FINALIZE=512

# Lambda Reserved Concurrency
LAMBDA_CONCURRENCY_PROCESS_CLIP=200
LAMBDA_CONCURRENCY_TRANSCRIBE=50
LAMBDA_CONCURRENCY_DETECT_CLIPS=50
LAMBDA_CONCURRENCY_DOWNLOAD=50
LAMBDA_CONCURRENCY_API_GATEWAY=100

# ========================================
# Feature Flags
# ========================================
ENABLE_WEBSOCKET_UPDATES=true
ENABLE_CACHING=true
ENABLE_METRICS=true
ENABLE_CIRCUIT_BREAKER=true

# ========================================
# Development/Debug
# ========================================
ENVIRONMENT=prod  # Options: dev, staging, prod
DEBUG_MODE=false
ENABLE_CORS=true
